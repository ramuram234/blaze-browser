<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg">

    <!-- Main browser UI -->
    <LinearLayout
        android:id="@+id/browser_ui"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- Top address bar -->
        <LinearLayout
            android:id="@+id/address_bar"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:background="@color/surface"
            android:gravity="center_vertical"
            android:paddingStart="12dp"
            android:paddingEnd="8dp"
            android:elevation="2dp">

            <ImageView
                android:id="@+id/favicon_view"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_marginEnd="2dp"
                android:scaleType="centerCrop"
                android:contentDescription="Site favicon"
                android:src="@android:drawable/sym_def_app_icon" />

            <ImageView
                android:id="@+id/security_indicator"
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:layout_marginEnd="4dp"
                android:scaleType="centerInside"
                android:visibility="gone"
                android:contentDescription="Connection security" />

            <EditText
                android:id="@+id/address"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:background="@android:color/transparent"
                android:hint="@string/address_hint"
                android:imeOptions="actionGo"
                android:importantForAutofill="no"
                android:inputType="textUri"
                android:paddingStart="4dp"
                android:paddingEnd="4dp"
                android:singleLine="true"
                android:textColor="@color/ink"
                android:textColorHint="@color/muted"
                android:textSize="14sp" />

            <ImageButton
                android:id="@+id/btn_go"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Refresh"
                android:src="@drawable/ic_reload" />

            <ImageButton
                android:id="@+id/btn_bookmark_page"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Bookmark"
                android:src="@drawable/ic_star" />

            <!-- Download speed badge (R5) -->
            <TextView
                android:id="@+id/dl_speed_badge"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:gravity="center"
                android:paddingStart="6dp"
                android:paddingEnd="6dp"
                android:textSize="11sp"
                android:textColor="@color/primary"
                android:textStyle="bold"
                android:visibility="gone" />
        </LinearLayout>

        <ProgressBar
            android:id="@+id/progress"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="2dp"
            android:max="100"
            android:progressTint="@color/primary"
            android:visibility="gone" />

        <!-- Web content -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <FrameLayout
                android:id="@+id/web_stack"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />

            <!-- In-page video controls overlay (UC Browser video_site_controls_layout style) -->
            <LinearLayout
                android:id="@+id/video_overlay_bar"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="top|end"
                android:layout_margin="8dp"
                android:layout_marginTop="64dp"
                android:orientation="vertical"
                android:padding="6dp"
                android:elevation="4dp"
                android:background="@drawable/overlay_bar_bg"
                android:visibility="gone">

                <ImageButton
                    android:id="@+id/btn_overlay_pip"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:layout_marginBottom="4dp"
                    android:background="?android:attr/selectableItemBackgroundBorderless"
                    android:contentDescription="Enter PiP"
                    android:src="@android:drawable/ic_menu_slideshow"
                    android:tint="#FFFFFFFF" />

                <ImageButton
                    android:id="@+id/btn_overlay_dl"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:layout_marginBottom="4dp"
                    android:background="?android:attr/selectableItemBackgroundBorderless"
                    android:contentDescription="Download video"
                    android:src="@android:drawable/stat_sys_download"
                    android:tint="#FFFFFFFF" />

                <ImageButton
                    android:id="@+id/btn_overlay_audio"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:background="?android:attr/selectableItemBackgroundBorderless"
                    android:contentDescription="Toggle audio"
                    android:src="@android:drawable/ic_lock_silent_mode_off"
                    android:tint="#FFFFFFFF" />
            </LinearLayout>

            <TextView
                android:id="@+id/btn_play"
                android:layout_width="wrap_content"
                android:layout_height="44dp"
                android:layout_gravity="bottom|center_horizontal"
                android:layout_marginBottom="12dp"
                android:background="@drawable/play_chip"
                android:gravity="center"
                android:paddingStart="20dp"
                android:paddingEnd="20dp"
                android:text="Watch video"
                android:textColor="#FFFFFF"
                android:textStyle="bold"
                android:visibility="gone" />
        </FrameLayout>

        <!-- Bottom nav bar - UC Browser style -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:background="@drawable/bottom_nav_bg"
            android:gravity="center"
            android:elevation="4dp">

            <ImageButton
                android:id="@+id/btn_back"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Back"
                android:src="@drawable/ic_back" />

            <ImageButton
                android:id="@+id/btn_forward"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Forward"
                android:src="@drawable/ic_forward" />

            <ImageButton
                android:id="@+id/btn_menu"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Menu"
                android:src="@drawable/ic_menu" />

            <!-- Tabs count box -->
            <FrameLayout
                android:id="@+id/btn_tabs_wrapper"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="?attr/selectableItemBackgroundBorderless">
                <TextView
                    android:id="@+id/btn_tabs"
                    android:layout_width="26dp"
                    android:layout_height="26dp"
                    android:layout_gravity="center"
                    android:background="@drawable/ic_tabs_bg"
                    android:gravity="center"
                    android:text="1"
                    android:textColor="#66707A"
                    android:textSize="12sp"
                    android:textStyle="bold" />
            </FrameLayout>

            <ImageButton
                android:id="@+id/btn_home"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Home"
                android:src="@drawable/ic_home" />
        </LinearLayout>
    </LinearLayout>

    <!-- Video sniff bar -->
    <include
        android:id="@+id/video_sniff_bar_root"
        layout="@layout/video_sniff_bar"
        android:layout_width="match_parent"
        android:layout_height="72dp"
        android:layout_gravity="bottom"
        android:layout_marginBottom="56dp" />

    <!-- Tabs panel -->
    <FrameLayout
        android:id="@+id/tabs_panel"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/tab_bg"
        android:visibility="gone">

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginTop="0dp"
            android:layout_marginBottom="72dp">
            <LinearLayout
                android:id="@+id/tab_list"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />
        </ScrollView>

        <!-- Bottom: ghost, FAB +, undo -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="72dp"
            android:layout_gravity="bottom"
            android:background="#2D2F33"
            android:gravity="center"
            android:padding="8dp">

            <ImageButton
                android:id="@+id/btn_private_tab"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:background="@android:color/transparent"
                android:contentDescription="Private"
                android:src="@drawable/ic_ghost" />

            <FrameLayout
                android:layout_width="56dp"
                android:layout_height="56dp">
                <TextView
                    android:id="@+id/btn_new_tab"
                    android:layout_width="52dp"
                    android:layout_height="52dp"
                    android:layout_gravity="center"
                    android:background="@drawable/fab_bg"
                    android:gravity="center"
                    android:text="+"
                    android:textColor="#FFFFFF"
                    android:textSize="28sp"
                    android:textStyle="bold" />
            </FrameLayout>

            <ImageButton
                android:id="@+id/btn_undo_close"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:background="@android:color/transparent"
                android:contentDescription="Undo"
                android:src="@drawable/ic_back" />
        </LinearLayout>
    </FrameLayout>

    <!-- Menu bottom sheet scrim -->
    <FrameLayout
        android:id="@+id/menu_sheet_scrim"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#88000000"
        android:visibility="gone">

        <LinearLayout
            android:id="@+id/menu_panel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:background="@drawable/sheet_bg"
            android:orientation="vertical"
            android:paddingBottom="24dp">

            <!-- Header row: avatar + title + ghost -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="72dp"
                android:gravity="center_vertical"
                android:padding="16dp">

                <FrameLayout
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:background="@drawable/fab_bg">
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:text="B"
                        android:textColor="#FFFFFF"
                        android:textSize="18sp"
                        android:textStyle="bold" />
                </FrameLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="12dp"
                    android:orientation="vertical">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Blaze Browser"
                        android:textColor="@color/ink"
                        android:textSize="15sp"
                        android:textStyle="bold" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Private &amp; Fast"
                        android:textColor="@color/muted"
                        android:textSize="12sp" />
                </LinearLayout>

                <ImageButton
                    android:id="@+id/btn_private_mode"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="@drawable/shortcut_bg"
                    android:contentDescription="Private"
                    android:src="@drawable/ic_ghost" />
            </LinearLayout>

            <!-- Row 1: Bookmarks, History, Downloads, Night, Settings -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingStart="4dp"
                android:paddingEnd="4dp"
                android:paddingBottom="12dp">

                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:gravity="center" android:padding="6dp">
                    <FrameLayout android:layout_width="48dp" android:layout_height="48dp" android:background="@drawable/circle_teal">
                        <ImageButton android:id="@+id/menu_bookmarks" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@android:color/transparent" android:src="@drawable/ic_bookmark_teal" android:contentDescription="Bookmarks" android:scaleType="centerInside"/>
                    </FrameLayout>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Bookmarks" android:textSize="10sp" android:textColor="@color/ink" android:layout_marginTop="5dp" android:gravity="center"/>
                </LinearLayout>

                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:gravity="center" android:padding="6dp">
                    <FrameLayout android:layout_width="48dp" android:layout_height="48dp" android:background="@drawable/circle_yellow">
                        <ImageButton android:id="@+id/menu_history" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@android:color/transparent" android:src="@drawable/ic_history_clock" android:contentDescription="History" android:scaleType="centerInside"/>
                    </FrameLayout>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="History" android:textSize="10sp" android:textColor="@color/ink" android:layout_marginTop="5dp"/>
                </LinearLayout>

                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:gravity="center" android:padding="6dp">
                    <FrameLayout android:layout_width="48dp" android:layout_height="48dp" android:background="@drawable/circle_blue">
                        <ImageButton android:id="@+id/menu_downloads" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@android:color/transparent" android:src="@drawable/ic_download_arrow" android:contentDescription="Downloads" android:scaleType="centerInside"/>
                    </FrameLayout>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Downloads" android:textSize="10sp" android:textColor="@color/ink" android:layout_marginTop="5dp"/>
                </LinearLayout>

                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:gravity="center" android:padding="6dp">
                    <FrameLayout android:layout_width="48dp" android:layout_height="48dp" android:background="@drawable/circle_pink">
                        <ImageButton android:id="@+id/menu_night" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@android:color/transparent" android:src="@drawable/ic_moon" android:contentDescription="Night" android:scaleType="centerInside"/>
                    </FrameLayout>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Night" android:textSize="10sp" android:textColor="@color/ink" android:layout_marginTop="5dp"/>
                </LinearLayout>

                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:gravity="center" android:padding="6dp">
                    <FrameLayout android:layout_width="48dp" android:layout_height="48dp" android:background="@drawable/circle_purple">
                        <ImageButton android:id="@+id/menu_settings_btn" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@android:color/transparent" android:src="@drawable/ic_settings_gear" android:contentDescription="Settings" android:scaleType="centerInside"/>
                    </FrameLayout>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Settings" android:textSize="10sp" android:textColor="@color/ink" android:layout_marginTop="5dp"/>
                </LinearLayout>
            </LinearLayout>

            <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/divider" android:layout_marginStart="16dp" android:layout_marginEnd="16dp"/>

            <!-- Row 2: Bookmark, Refresh, Share, Desktop, Clear -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingStart="4dp"
                android:paddingEnd="4dp"
                android:paddingTop="8dp">

                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:gravity="center" android:padding="8dp">
                    <ImageButton android:id="@+id/menu_add_bookmark" android:layout_width="40dp" android:layout_height="40dp" android:background="?attr/selectableItemBackgroundBorderless" android:src="@drawable/ic_star" android:contentDescription="Bookmark"/>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Bookmark" android:textSize="10sp" android:textColor="@color/muted" android:layout_marginTop="4dp" android:gravity="center"/>
                </LinearLayout>

                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:gravity="center" android:padding="8dp">
                    <ImageButton android:id="@+id/menu_refresh" android:layout_width="40dp" android:layout_height="40dp" android:background="?attr/selectableItemBackgroundBorderless" android:src="@drawable/ic_reload" android:contentDescription="Refresh"/>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Refresh" android:textSize="10sp" android:textColor="@color/muted" android:layout_marginTop="4dp"/>
                </LinearLayout>

                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:gravity="center" android:padding="8dp">
                    <ImageButton android:id="@+id/menu_share" android:layout_width="40dp" android:layout_height="40dp" android:background="?attr/selectableItemBackgroundBorderless" android:src="@drawable/ic_share" android:contentDescription="Share"/>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Share" android:textSize="10sp" android:textColor="@color/muted" android:layout_marginTop="4dp"/>
                </LinearLayout>

                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:gravity="center" android:padding="8dp">
                    <ImageButton android:id="@+id/menu_desktop" android:layout_width="40dp" android:layout_height="40dp" android:background="?attr/selectableItemBackgroundBorderless" android:src="@drawable/ic_home" android:contentDescription="Desktop"/>
                    <TextView android:id="@+id/menu_desktop_label" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Desktop" android:textSize="10sp" android:textColor="@color/muted" android:layout_marginTop="4dp"/>
                </LinearLayout>

                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:gravity="center" android:padding="8dp">
                    <ImageButton android:id="@+id/menu_clear_cache" android:layout_width="40dp" android:layout_height="40dp" android:background="?attr/selectableItemBackgroundBorderless" android:src="@drawable/ic_ghost" android:contentDescription="Clear"/>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Clear" android:textSize="10sp" android:textColor="@color/muted" android:layout_marginTop="4dp"/>
                </LinearLayout>
            </LinearLayout>

            <!-- Close chevron -->

            <!-- Row 3: Find, Translate, Reader, Private tab -->
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingStart="4dp" android:paddingEnd="4dp" android:paddingTop="4dp">
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:gravity="center" android:padding="8dp">
                    <ImageButton android:id="@+id/menu_find" android:layout_width="40dp" android:layout_height="40dp" android:background="?attr/selectableItemBackgroundBorderless" android:src="@drawable/ic_go" android:contentDescription="Find"/>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Find" android:textSize="10sp" android:textColor="@color/muted" android:layout_marginTop="4dp"/>
                </LinearLayout>
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:gravity="center" android:padding="8dp">
                    <ImageButton android:id="@+id/menu_translate" android:layout_width="40dp" android:layout_height="40dp" android:background="?attr/selectableItemBackgroundBorderless" android:src="@drawable/ic_menu" android:contentDescription="Translate"/>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Translate" android:textSize="10sp" android:textColor="@color/muted" android:layout_marginTop="4dp"/>
                </LinearLayout>
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:gravity="center" android:padding="8dp">
                    <ImageButton android:id="@+id/menu_reader_mode" android:layout_width="40dp" android:layout_height="40dp" android:background="?attr/selectableItemBackgroundBorderless" android:src="@drawable/ic_star" android:contentDescription="Reader"/>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Reader" android:textSize="10sp" android:textColor="@color/muted" android:layout_marginTop="4dp"/>
                </LinearLayout>
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:gravity="center" android:padding="8dp">
                    <ImageButton android:id="@+id/menu_new_private" android:layout_width="40dp" android:layout_height="40dp" android:background="?attr/selectableItemBackgroundBorderless" android:src="@drawable/ic_ghost" android:contentDescription="Private"/>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Private" android:textSize="10sp" android:textColor="@color/muted" android:layout_marginTop="4dp"/>
                </LinearLayout>
                <View android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1"/>
            </LinearLayout>
            <TextView
                android:id="@+id/menu_data_saver"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:gravity="center_vertical"
                android:paddingStart="20dp"
                android:paddingEnd="20dp"
                android:text="Data Saver: OFF"
                android:textSize="14sp"
                android:textColor="@color/ink"
                android:background="?attr/selectableItemBackground" />

            <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#15000000"/>

            <TextView
                android:id="@+id/menu_close"
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:gravity="center"
                android:text="⌄"
                android:textColor="@color/muted"
                android:textSize="22sp"
                android:layout_marginTop="8dp"/>
        </LinearLayout>
    </FrameLayout>

    <!-- Fullscreen video holder -->
    <FrameLayout
        android:id="@+id/fullscreen_holder"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#000000"
        android:visibility="gone">

        <FrameLayout
            android:id="@+id/fs_video"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <View
            android:id="@+id/fs_gestures"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginTop="56dp"
            android:layout_marginBottom="96dp" />

        <TextView
            android:id="@+id/fs_hud"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:background="#CC111111"
            android:paddingStart="18dp"
            android:paddingTop="12dp"
            android:paddingEnd="18dp"
            android:paddingBottom="12dp"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/fs_chrome"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_gravity="top"
            android:background="#CC000000"
            android:elevation="24dp"
            android:gravity="center_vertical"
            android:paddingStart="4dp"
            android:paddingEnd="8dp">

            <ImageButton
                android:id="@+id/fs_close"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@android:color/transparent"
                android:contentDescription="Close"
                android:src="@android:drawable/ic_menu_close_clear_cancel" />

            <TextView
                android:id="@+id/fs_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="Video"
                android:textColor="#FFFFFF"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/fs_pip"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:gravity="center"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:text="PiP"
                android:textColor="#FFFFFF"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/fs_rotate"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:gravity="center"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:text="Landscape"
                android:textColor="#FFB020"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/fs_controls"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:background="#E6000000"
            android:elevation="24dp"
            android:orientation="vertical"
            android:paddingStart="8dp"
            android:paddingTop="8dp"
            android:paddingEnd="8dp"
            android:paddingBottom="12dp">

            <TextView
                android:id="@+id/fs_time"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingStart="8dp"
                android:text="00:00 / 00:00"
                android:textColor="#FFFFFF"
                android:textSize="12sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:gravity="center">

                <TextView
                    android:id="@+id/fs_play"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:text="Pause"
                    android:textColor="#FFFFFF"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/fs_back"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:text="-10s"
                    android:textColor="#FFFFFF"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/fs_fwd"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:text="+10s"
                    android:textColor="#FFFFFF"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/fs_jump"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:text="+30s"
                    android:textColor="#FFB020"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/fs_speed"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:text="1.0x"
                    android:textColor="#FFFFFF"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>
    </FrameLayout>

    <!-- Network speed overlay -->
    <TextView
        android:id="@+id/net_speed_overlay"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_marginBottom="60dp"
        android:layout_marginEnd="8dp"
        android:background="#BF000000"
        android:clickable="false"
        android:focusable="false"
        android:paddingStart="6dp"
        android:paddingEnd="6dp"
        android:paddingTop="2dp"
        android:paddingBottom="2dp"
        android:textColor="#FFFFFF"
        android:textSize="11sp"
        android:visibility="gone" />

</FrameLayout>
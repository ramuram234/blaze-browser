<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/video_sniff_bar_root"
    android:layout_width="match_parent"
    android:layout_height="72dp"
    android:layout_gravity="bottom"
    android:background="#CC1A1A2E"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="16dp"
    android:paddingEnd="8dp"
    android:elevation="8dp"
    android:visibility="gone">
    <TextView android:id="@+id/sniff_icon"
        android:layout_width="32dp" android:layout_height="32dp"
        android:gravity="center" android:text="&#127909;" android:textSize="18sp"/>
    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
        android:layout_weight="1" android:layout_marginStart="12dp" android:orientation="vertical">
        <TextView android:id="@+id/sniff_bar_title"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:maxLines="1" android:ellipsize="end"
            android:text="Video found"
            android:textColor="#FFFFFF" android:textSize="13sp" android:textStyle="bold"/>
        <TextView android:id="@+id/sniff_bar_domain"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:maxLines="1" android:ellipsize="end"
            android:textColor="#AAAAAA" android:textSize="11sp"/>
    </LinearLayout>
    <Button android:id="@+id/sniff_bar_play"
        android:layout_width="wrap_content" android:layout_height="36dp"
        android:text="Play" android:textColor="#FFFFFF"
        android:background="#441A73E8" android:textSize="12sp" android:textStyle="bold"/>
    <Button android:id="@+id/sniff_bar_download"
        android:layout_width="wrap_content" android:layout_height="36dp"
        android:layout_marginStart="8dp"
        android:text="Save" android:textColor="#FFFFFF"
        android:background="#441A73E8" android:textSize="12sp" android:textStyle="bold"/>
</LinearLayout>
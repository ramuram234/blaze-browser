<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <!-- Video surface -->
    <androidx.media3.ui.PlayerView
        android:id="@+id/player_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:surface_type="texture_view"
        app:show_buffering="when_playing"
        app:use_controller="false" />

    <!--
        Gesture layer sits between player_view and the control overlays.
        marginTop=56dp clears the top bar; marginBottom=96dp clears seek row.
        marginEnd=60dp clears the always-visible download button on the right.
    -->
    <View
        android:id="@+id/gesture_layer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="56dp"
        android:layout_marginBottom="96dp"
        android:layout_marginEnd="60dp" />

    <!-- HUD overlay (seek / volume / brightness feedback) -->
    <TextView
        android:id="@+id/hud"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:background="#CC1A1A2E"
        android:paddingStart="20dp"
        android:paddingTop="14dp"
        android:paddingEnd="20dp"
        android:paddingBottom="14dp"
        android:textColor="#FFFFFF"
        android:textSize="16sp"
        android:textStyle="bold"
        android:visibility="gone" />

    <!-- Lock icon - left side (shown when screen is locked) -->
    <TextView
        android:id="@+id/btn_lock_icon"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:layout_gravity="center_vertical|start"
        android:layout_marginStart="16dp"
        android:background="#66000000"
        android:gravity="center"
        android:text="&#128274;"
        android:textSize="18sp"
        android:visibility="gone" />

    <!--
        Download button + progress ring (R11).
        Ring overlaid on top; ring is gone by default.
    -->
    <FrameLayout
        android:layout_width="52dp"
        android:layout_height="52dp"
        android:layout_gravity="center_vertical|end"
        android:layout_marginEnd="4dp"
        android:elevation="4dp">

        <TextView
            android:id="@+id/btn_download_overlay"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#CC000000"
            android:gravity="center"
            android:text="&#11015;"
            android:textColor="#FFFFFF"
            android:textSize="20sp"
            android:visibility="visible" />

        <app.blaze.browser.DownloadProgressRing
            android:id="@+id/download_progress_ring"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:padding="4dp"
            android:visibility="gone" />
    </FrameLayout>

    <!-- Live network speed indicator - top-left corner -->
    <TextView
        android:id="@+id/speed_overlay"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|start"
        android:layout_marginTop="64dp"
        android:layout_marginStart="12dp"
        android:background="#99000000"
        android:paddingStart="8dp"
        android:paddingTop="3dp"
        android:paddingEnd="8dp"
        android:paddingBottom="3dp"
        android:textColor="#44FFFFFF"
        android:textSize="10sp"
        android:visibility="invisible" />

    <!-- Data usage meter - top-right corner (shown while controls visible) -->
    <TextView
        android:id="@+id/data_meter"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|end"
        android:layout_marginTop="64dp"
        android:layout_marginEnd="12dp"
        android:background="#99000000"
        android:paddingStart="8dp"
        android:paddingTop="3dp"
        android:paddingEnd="8dp"
        android:paddingBottom="3dp"
        android:text="&#128246; 0 B"
        android:textColor="#CCFFFFFF"
        android:textSize="11sp"
        android:visibility="gone" />

    <!-- Top bar: back + title + menu -->
    <LinearLayout
        android:id="@+id/player_top_bar"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_gravity="top"
        android:background="#CC000000"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="4dp"
        android:paddingEnd="4dp"
        android:elevation="2dp">

        <ImageButton
            android:id="@+id/close_player"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="@android:color/transparent"
            android:contentDescription="Back"
            android:src="@drawable/ic_back" />

        <TextView
            android:id="@+id/player_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:paddingStart="4dp"
            android:paddingEnd="4dp"
            android:text="Video"
            android:textColor="#FFFFFF"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/player_menu_btn"
            android:layout_width="44dp"
            android:layout_height="48dp"
            android:gravity="center"
            android:text="&#8943;"
            android:textColor="#FFFFFF"
            android:textSize="22sp" />
    </LinearLayout>

    <!-- Bottom controls bar -->
    <LinearLayout
        android:id="@+id/player_bottom"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="#CC000000"
        android:orientation="vertical"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:paddingTop="6dp"
        android:paddingBottom="8dp"
        android:elevation="2dp">

        <!-- Time row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/time_current"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0:00"
                android:textColor="#FFFFFF"
                android:textSize="12sp" />

            <SeekBar
                android:id="@+id/seek_bar"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:layout_marginEnd="8dp"
                android:max="1000"
                android:progressTint="#FFFFFF"
                android:thumbTint="#FFFFFF" />

            <TextView
                android:id="@+id/time_total"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0:00"
                android:textColor="#AAAAAA"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- Controls row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <!-- Play/Pause -->
            <TextView
                android:id="@+id/btn_play_pause"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:gravity="center"
                android:text="&#9646;&#9646;"
                android:textColor="#FFFFFF"
                android:textSize="18sp" />

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <!-- Speed -->
            <TextView
                android:id="@+id/btn_speed"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:gravity="center"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:text="1.0x"
                android:textColor="#FFFFFF"
                android:textSize="13sp"
                android:textStyle="bold" />

            <!-- PiP -->
            <TextView
                android:id="@+id/pip_player"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:gravity="center"
                android:text="&#9974;"
                android:textColor="#FFFFFF"
                android:textSize="18sp" />

            <!-- Lock -->
            <TextView
                android:id="@+id/btn_lock"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:gravity="center"
                android:text="&#128275;"
                android:textColor="#FFFFFF"
                android:textSize="16sp" />

            <!-- BG Audio -->
            <TextView
                android:id="@+id/btn_bg_audio"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:gravity="center"
                android:text="&#127911;"
                android:textColor="#AAAAAA"
                android:textSize="18sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- Hint overlay (shown on first launch) -->
    <TextView
        android:id="@+id/hint"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal|top"
        android:layout_marginTop="80dp"
        android:background="#CC0C0D10"
        android:padding="12dp"
        android:text="Tap to show/hide controls  |  Swipe to seek, brightness, volume"
        android:textAlignment="center"
        android:textColor="#FFFFFF"
        android:textSize="13sp" />

    <!-- Settings panel (slides in from right) -->
    <LinearLayout
        android:id="@+id/settings_panel"
        android:layout_width="180dp"
        android:layout_height="wrap_content"
        android:layout_gravity="end|center_vertical"
        android:background="#CC1A1A1A"
        android:orientation="vertical"
        android:padding="8dp"
        android:elevation="8dp"
        android:visibility="gone">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="8dp"
            android:text="Player Settings"
            android:textColor="#AAAAAA"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/panel_bg_audio"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:gravity="center_vertical"
            android:padding="12dp"
            android:text="Background Audio: Off"
            android:textColor="#FFFFFF"
            android:textSize="13sp" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#44FFFFFF" />

        <TextView
            android:id="@+id/panel_preload_label"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:gravity="center_vertical"
            android:padding="12dp"
            android:text="Buffer: Normal"
            android:textColor="#FFFFFF"
            android:textSize="13sp" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#44FFFFFF" />

        <TextView
            android:id="@+id/panel_speed_label"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:gravity="center_vertical"
            android:padding="12dp"
            android:text="Speed: 1.0x"
            android:textColor="#FFFFFF"
            android:textSize="13sp" />
    </LinearLayout>

</FrameLayout>

<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="16dp"
    android:paddingEnd="16dp"
    android:paddingTop="12dp"
    android:paddingBottom="12dp"
    android:background="?attr/selectableItemBackground">

    <!-- UC Browser: download_task_icon + download_task_name row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <!-- UC Browser: download_left_icon_contaner (file type icon) -->
        <FrameLayout
            android:id="@+id/download_left_icon_contaner"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginEnd="12dp">
            <TextView
                android:id="@+id/download_task_icon"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:background="#FF9C38"
                android:textColor="#FFFFFF"
                android:textSize="12sp"
                android:textStyle="bold"
                android:text="VID" />
        </FrameLayout>

        <!-- UC Browser: download_task_name + download_file_size -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/download_task_name"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="7"
                    android:maxLines="1"
                    android:ellipsize="middle"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="#4F4F4F" />

                <TextView
                    android:id="@+id/download_file_size"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="3"
                    android:gravity="end"
                    android:maxLines="1"
                    android:textSize="12sp"
                    android:textColor="@color/muted" />
            </LinearLayout>

            <!-- UC Browser: download_task_progress (DownloadProgressBar) -->
            <ProgressBar
                android:id="@+id/download_task_progress"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="4dp"
                android:layout_marginTop="6dp"
                android:layout_marginBottom="4dp"
                android:max="100"
                android:progressTint="#FF9C38" />

            <!-- UC Browser: download_task_speed + download_cursize -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/download_task_speed"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:maxLines="1"
                    android:textSize="12sp"
                    android:textColor="#FF9C38" />

                <TextView
                    android:id="@+id/download_cursize"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minWidth="60dp"
                    android:maxLines="1"
                    android:gravity="end"
                    android:textSize="12sp"
                    android:textColor="@color/muted" />

                <TextView
                    android:id="@+id/item_pct"
                    android:layout_width="40dp"
                    android:layout_height="wrap_content"
                    android:gravity="end"
                    android:textSize="12sp"
                    android:textColor="@color/muted"
                    android:text="0%" />
            </LinearLayout>
        </LinearLayout>

        <!-- UC Browser: download_task_btn (action button) -->
        <ImageButton
            android:id="@+id/download_task_btn"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_marginStart="8dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:src="@android:drawable/ic_media_pause"
            android:contentDescription="Pause/Resume" />
    </LinearLayout>

    <!-- Status badge row -->
    <LinearLayout
        android:id="@+id/item_actions"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/item_status_label"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textSize="12sp"
            android:textColor="#FF9C38"
            android:text="Downloading" />

        <!-- UC Browser: download_play_btn (for completed files) -->
        <Button
            android:id="@+id/download_play_btn"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:textSize="12sp"
            android:text="Open"
            android:visibility="gone"
            android:backgroundTint="#FF9C38"
            android:textColor="#FFFFFF" />

        <Button
            android:id="@+id/btn_pause_resume"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:textSize="12sp"
            android:text="Pause"
            android:visibility="visible" />

        <Button
            android:id="@+id/btn_cancel"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:layout_marginStart="8dp"
            android:textSize="12sp"
            android:text="Cancel"
            android:visibility="visible" />

        <Button
            android:id="@+id/btn_open"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:layout_marginStart="8dp"
            android:textSize="12sp"
            android:text="Open"
            android:visibility="gone" />

        <Button
            android:id="@+id/btn_retry"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:layout_marginStart="8dp"
            android:textSize="12sp"
            android:text="Retry"
            android:visibility="gone" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="8dp"
        android:background="#22000000" />
</LinearLayout>